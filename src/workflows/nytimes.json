{
  "job_id": "DATABRICKS_JOBID",
  "new_settings": {
    "name": "New York Times",
    "email_notifications": {
      "no_alert_for_skipped_runs": false
    },
    "webhook_notifications": {},
    "timeout_seconds": 0,
    "schedule": {
      "quartz_cron_expression": "7 05 19 * * ?",
      "timezone_id": "UTC",
      "pause_status": "UNPAUSED"
    },
    "max_concurrent_runs": 1,
    "tasks": [
      {
        "task_key": "Bronze_Top_Stories",
        "run_if": "ALL_SUCCESS",
        "notebook_task": {
          "notebook_path": "src/bronze/Bronze - Ingestion",
          "base_parameters": {
            "schema_name": "bronze",
            "database_name": "nytimes",
            "table_name": "top_stories",
            "partition_column": "ref_date"
          },
          "source": "GIT"
        },
        "timeout_seconds": 0,
        "email_notifications": {
          "on_failure": [
            "DATABRICKS_USER"
          ]
        },
        "notification_settings": {
          "no_alert_for_skipped_runs": false,
          "no_alert_for_canceled_runs": false,
          "alert_on_last_attempt": false
        },
        "webhook_notifications": {}
      },
      {
        "task_key": "Silver_Top_Stories",
        "depends_on": [
          {
            "task_key": "Bronze_Top_Stories"
          }
        ],
        "run_if": "ALL_SUCCESS",
        "notebook_task": {
          "notebook_path": "src/silver/cdf/Silver - Ingestion",
          "base_parameters": {
            "src_catalog": "bronze",
            "src_schema": "nytimes",
            "src_table": "top_stories",
            "tgt_catalog": "silver",
            "tgt_schema": "nytimes",
            "tgt_table": "top_stories",
            "tgt_partition": "ref_date"
          },
          "source": "GIT"
        },
        "timeout_seconds": 0,

        "email_notifications": {
          "on_failure": [
            "DATABRICKS_USER"
          ]
        },
        "notification_settings": {
          "no_alert_for_skipped_runs": false,
          "no_alert_for_canceled_runs": false,
          "alert_on_last_attempt": false
        },
        "webhook_notifications": {}
      },
      {
        "task_key": "Gold_Daily_Trending_Topics",
        "depends_on": [
          {
            "task_key": "Silver_Top_Stories"
          }
        ],
        "run_if": "ALL_SUCCESS",
        "notebook_task": {
          "notebook_path": "src/gold/Gold - Ingestion",
          "base_parameters": {
            "src_catalog": "silver",
            "src_schema": "nytimes",
            "src_table": "top_stories",
            "src_partition": "ref_date",
            "tgt_catalog": "gold",
            "tgt_schema": "nytimes",
            "tgt_table": "daily_trending_topics",
            "tgt_partition": "ref_date",
            "partition_type": "day"
          },
          "source": "GIT"
        },
        "timeout_seconds": 0,

        "email_notifications": {
          "on_failure": [
            "DATABRICKS_USER"
          ]
        },
        "notification_settings": {
          "no_alert_for_skipped_runs": false,
          "no_alert_for_canceled_runs": false,
          "alert_on_last_attempt": false
        },
        "webhook_notifications": {}
      },
      {
        "task_key": "Gold_Last_30d_Top_Authors",
        "depends_on": [
          {
            "task_key": "Silver_Top_Stories"
          }
        ],
        "run_if": "ALL_SUCCESS",
        "notebook_task": {
          "notebook_path": "src/gold/Gold - Ingestion",
          "base_parameters": {
            "src_catalog": "silver",
            "src_schema": "nytimes",
            "src_table": "top_stories",
            "src_partition": "ref_date",
            "tgt_catalog": "gold",
            "tgt_schema": "nytimes",
            "tgt_table": "last_30d_top_authors",
            "tgt_partition": "ref_date",
            "partition_type": "last_30d"
          },
          "source": "GIT"
        },
        "timeout_seconds": 0,

        "email_notifications": {
          "on_failure": [
            "DATABRICKS_USER"
          ]
        },
        "notification_settings": {
          "no_alert_for_skipped_runs": false,
          "no_alert_for_canceled_runs": false,
          "alert_on_last_attempt": false
        },
        "webhook_notifications": {}
      },
      {
        "task_key": "Gold_Weekly_Trending_Persons",
        "depends_on": [
          {
            "task_key": "Silver_Top_Stories"
          }
        ],
        "run_if": "ALL_SUCCESS",
        "notebook_task": {
          "notebook_path": "src/gold/Gold - Ingestion",
          "base_parameters": {
            "src_catalog": "silver",
            "src_schema": "nytimes",
            "src_table": "top_stories",
            "src_partition": "ref_date",
            "tgt_catalog": "gold",
            "tgt_schema": "nytimes",
            "tgt_table": "weekly_trending_persons",
            "tgt_partition": "ref_date",
            "partition_type": "week"
          },
          "source": "GIT"
        },
        "timeout_seconds": 0,

        "email_notifications": {
          "on_failure": [
            "DATABRICKS_USER"
          ]
        },
        "notification_settings": {
          "no_alert_for_skipped_runs": false,
          "no_alert_for_canceled_runs": false,
          "alert_on_last_attempt": false
        },
        "webhook_notifications": {}
      },
      {
        "task_key": "Gold_Last_30d_Trending_Organizations",
        "depends_on": [
          {
            "task_key": "Silver_Top_Stories"
          }
        ],
        "run_if": "ALL_SUCCESS",
        "notebook_task": {
          "notebook_path": "src/gold/Gold - Ingestion",
          "base_parameters": {
            "src_catalog": "silver",
            "src_schema": "nytimes",
            "src_table": "top_stories",
            "src_partition": "ref_date",
            "tgt_catalog": "gold",
            "tgt_schema": "nytimes",
            "tgt_table": "last_30d_trending_organizations",
            "tgt_partition": "ref_date",
            "partition_type": "last_30d"
          },
          "source": "GIT"
        },
        "timeout_seconds": 0,

        "email_notifications": {
          "on_failure": [
            "DATABRICKS_USER"
          ]
        },
        "notification_settings": {
          "no_alert_for_skipped_runs": false,
          "no_alert_for_canceled_runs": false,
          "alert_on_last_attempt": false
        },
        "webhook_notifications": {}
      }
    ],
    "git_source": {
      "git_url": "https://github.com/ericknpeixoto/nytimes-topstories",
      "git_provider": "gitHub",
      "git_branch": "main"
    },
    "queue": {
      "enabled": true
    },
    "performance_target": "STANDARD",
    "run_as": {
      "user_name": "DATABRICKS_USER"
    }
  }
}