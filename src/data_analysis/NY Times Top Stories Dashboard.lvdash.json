{
  "datasets": [
    {
      "name": "1188d399",
      "displayName": "Trending Topics",
      "queryLines": [
        "SELECT\r\n",
        "    topic,\r\n",
        "    stories\r\n",
        "FROM gold.nytimes.daily_trending_topics\r\n",
        "WHERE ref_date = :selected_date\r\n",
        "ORDER BY stories DESC\r\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "selected_date",
          "keyword": "selected_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-09-02T00:00:00.000"
                }
              ]
            }
          }
        }
      ],
      "catalog": "gold",
      "schema": "nytimes"
    },
    {
      "name": "cbc5408a",
      "displayName": "Trending Persons",
      "queryLines": [
        "SELECT \r\n",
        "    person, \r\n",
        "    mentions\r\n",
        "FROM gold.nytimes.weekly_trending_persons\r\n",
        "WHERE week_number = WEEKOFYEAR(:selected_date)\r\n",
        "ORDER BY mentions DESC\r\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "selected_date",
          "keyword": "selected_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-09-02T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
